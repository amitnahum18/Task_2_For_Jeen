# Copy this file to .env and fill in real values. Never commit .env.

# Gemini API key - create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string. Must point at a database with the pgvector
# extension enabled (e.g. a Supabase or Neon project - both support pgvector
# as a one-click/one-command extension).
POSTGRES_URL=postgresql://user:password@host:5432/dbname

# Output dimensionality requested from gemini-embedding-001. Must match the
# VECTOR(N) column size used when the database schema is created.
EMBEDDING_DIM=768
